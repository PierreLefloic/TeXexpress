{
  "name": "texexpress",
  "productName": "TeXexpress",
  "version": "1.0.0",
  "description": "Type LaTeX, paste vector equations into PowerPoint, Affinity and more.",
  "main": "src/main/main.js",
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "prestart": "node scripts/vendor.js",
    "start": "electron .",
    "predist": "node scripts/vendor.js",
    "dist": "electron-builder",
    "dist:win": "npm run vendor && electron-builder --win",
    "dist:mac": "npm run vendor && electron-builder --mac",
    "icons": "electron scripts/icons.js"
  },
  "license": "MIT",
  "author": "Pierre Lefloïc",
  "build": {
    "appId": "app.texexpress.desktop",
    "productName": "TeXexpress",
    "copyright": "Copyright © 2026 Pierre Lefloïc",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "build/icon.png",
      "package.json",
      "!src/**/*.map",
      "!node_modules/koffi/{doc,src,vendor}/**",
      "!node_modules/koffi/build/koffi/{freebsd,linux,musl,openbsd}_*/**",
      "!node_modules/koffi/build/koffi/win32_ia32/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TeXexpress",
      "artifactName": "TeXexpress-Setup-${version}.${ext}",
      "license": "LICENSE"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "TeXexpress-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "electronLanguages": [
      "en-US",
      "fr"
    ],
    "extraResources": [
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ]
  },
  "devDependencies": {
    "@mathjax/mathjax-fira-font": "^4.1.3",
    "@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/mathjax-pagella-font": "^4.1.3",
    "@mathjax/mathjax-termes-font": "^4.1.3",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "mathjax": "^4.1.3"
  },
  "dependencies": {
    "koffi": "^2.16.4"
  }
}
